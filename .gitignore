# Built on install, from whatever Odoo source the machine has. They are large
# and they describe one computer's checkout, so they are never committed.
.xpath_anchors_cache.json
.widget_index.json
.owl_index.json

# The remembered path to that machine's Odoo source.
config.json

# Generated by the installer: it points at the local Odoo's type declarations.
jstypes/odoo-globals.d.ts

# Installed by the installer, per machine.
jstypes/node_modules/
jstypes/package-lock.json

__pycache__/
*.pyc
.DS_Store
Thumbs.db
