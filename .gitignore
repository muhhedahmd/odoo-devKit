# ── What the installer builds ────────────────────────────────────────
#
# These are read out of whatever Odoo checkout the machine has. They are
# several megabytes, they describe one computer, and they are rebuilt in
# about eight seconds — so they are never committed.
.xpath_anchors_cache.json
.widget_index.json
.owl_index.json

# The remembered path to that machine's Odoo source (written by --global).
config.json

# Generated: it references the local Odoo's own .d.ts files by absolute path.
jstypes/odoo-globals.d.ts

# ── Installed per machine ────────────────────────────────────────────
#
# The OWL and three type packages. `install.py` fetches them with npm, and
# `--pack` carries them to a machine with no network — but they do not
# belong in git: 43 MB of somebody else's code.
jstypes/node_modules/
jstypes/package-lock.json
node_modules/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Editors ──────────────────────────────────────────────────────────
#
# Not .vscode/ as a whole: this repository has nothing in it, but a project
# that the kit is installed into keeps its own, written by the installer.
*.code-workspace
.idea/
*.swp
*~

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Anything a run leaves behind ─────────────────────────────────────
*.log
*.tmp
tmp/
ols-output.json
output.json
